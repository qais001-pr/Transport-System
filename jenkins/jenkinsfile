pipeline{
    agent {
        kubernetes {}
    }    
    stages{
        stage('Clone Github Repository'){
            steps{
                 withCredentials([
                usernamePassword(
                credentialsId: 'github-credentials-token',
                usernameVariable: 'GITHUB_USER',
                passwordVariable: 'GITHUB_TOKEN'
            )
        ]) {
            sh '''
                git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/qais001-pr/School-Transport-System-Deployment.git
            '''
        }
            }
        }
        stage('List Repo'){
            steps{
                dir('School-Transport-System-Deployment'){
                    dir('helm'){
                        sh 
                        '''
                        cat values.yaml
                        cat Chart.yaml
                        yq -i '.version=1.1.1' Chart.yaml
                        cat values.yaml
                        cat Chart.yaml
                        
                        '''
                    }
                }
            }
        }
        stage('build'){
            steps{
                echo 'building'
            }
        }
        stage('test'){
            steps{
                echo 'testing'
            }
        }
        stage('deploy'){
            steps{
                echo 'deploying'
            }
        }
    }

    post{
        success{
            echo 'Pipeline succeeded'
        }
        failure{
            echo 'Pipeline failed'
        }
    }
}