pipeline {
    agent {
        kubernetes {
            inheritFrom 'kaniko-agent'
        }
    }

    stages {

        stage('Verify Tools') {
            steps {
                container('git') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-credentials-token',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                            echo "===== Git Version ====="
                            git --version

                            echo "===== Cloning Repository ====="
                            git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/qais001/School-Transport-System-Deployment.git deployment

                            echo "===== Repository Contents ====="
                            ls -lah
                            ls -lah deployment
                        '''
                    }
                }

                container('helm') {
                    sh '''
                        echo "===== Helm Version ====="
                        helm version

                        if ! command -v yq >/dev/null 2>&1; then
                            echo "Installing yq..."
                            wget -q https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /tmp/yq
                            chmod +x /tmp/yq
                        fi

                        echo "===== yq Version ====="
                        /tmp/yq --version
                    '''
                }
            }
        }

        /*
        stage('Build Backend Docker Image') {
            steps {
                container('kaniko') {
                    sh """
                    /kaniko/executor \
                        --context=$WORKSPACE/backend \
                        --dockerfile=$WORKSPACE/backend/Dockerfile \
                        --no-push
                    """
                }
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                container('kaniko') {
                    withCredentials([
                        string(credentialsId: 'VITE_API_URL', variable: 'VITE_API_URL'),
                        string(credentialsId: 'VITE_SOCKET_URL', variable: 'VITE_SOCKET_URL'),
                        string(credentialsId: 'VITE_VAPID_PUBLIC_KEY', variable: 'VITE_VAPID_PUBLIC_KEY')
                    ]) {
                        sh """
                        /kaniko/executor \
                            --context=$WORKSPACE/frontend \
                            --dockerfile=$WORKSPACE/frontend/Dockerfile.k8s \
                            --build-arg VITE_API_URL=$VITE_API_URL \
                            --build-arg VITE_SOCKET_URL=$VITE_SOCKET_URL \
                            --build-arg VITE_VAPID_PUBLIC_KEY=$VITE_VAPID_PUBLIC_KEY \
                            --no-push
                        """
                    }
                }
            }
        }
        */

    }

    post {
        always {
            cleanWs()
        }

        success {
            echo 'Pipeline succeeded'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}