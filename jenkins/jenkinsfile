pipeline{
    agent {
        kubernetes {}
    }    
    stages{
        stage('Clone Github Repository'){
            steps{
                withCredientials([
                    usernamePassword(
                    credientialsId: 'github-credentials-token',
                    usernameVariable: 'GITHUB_USER',
                    usernamePassword: 'GITHUB_TOKEN'    
                    )
                ])
                {
                    sh '''
                    git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/qais001-pr/School-Transport-System-Deployment.git
                    '''
                }
            }
        }
        stage('List Repo'){
            steps{
                dir('School-Transport-System-Deployment'){
                    sh 'ls -a'
                }
            }
        }
        stage('build'){
            steps{
                echo 'building'
            }
        }
        stage('test'){
            steps{
                echo 'testing'
            }
        }
        stage('deploy'){
            steps{
                echo 'deploying'
            }
        }
    }

    post{
        success{
            echo 'Pipeline succeeded'
        }
        failure{
            echo 'Pipeline failed'
        }
    }
}