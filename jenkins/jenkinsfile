pipeline{
    agent {
        kubernetes {}
    }    
    stages{
        stage('Clone Github Repository'){
            steps{
                git branch: 'main',
                    credientialsId: 'github-credentials-token'
                    uri: 'git@github.qais001-pr/School-Transport-System-Deployment.git'
            }
        }
        stage('List Repo'){
            steps{
                dir('School-Transport-System-Deployment'){
                    sh 'ls -a'
                }
            }
        }
        stage('build'){
            steps{
                echo 'building'
            }
        }
        stage('test'){
            steps{
                echo 'testing'
            }
        }
        stage('deploy'){
            steps{
                echo 'deploying'
            }
        }
    }

    post{
        success{
            echo 'Pipeline succeeded'
        }
        failure{
            echo 'Pipeline failed'
        }
    }
}