pipeline{
    agent {
        kubernetes {}
    }    
    stages{
        stage('Clone Github Repository'){
            steps{
                 withCredentials([
                usernamePassword(
                credentialsId: 'github-credentials-token',
                usernameVariable: 'GITHUB_USER',
                passwordVariable: 'GITHUB_TOKEN'
            )
        ]) {
            sh '''
                git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/qais001-pr/School-Transport-System-Deployment.git
            '''
        }
            }
        }
        stage('List Repo'){
            steps{
                stage('Update Helm Chart') {
    steps {
        dir('School-Transport-System-Deployment/helm') {
            sh '''
                # Install yq
                wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/local/bin/yq
                chmod +x /usr/local/bin/yq

                # Verify installation
                yq --version

                # Show current files
                cat Chart.yaml
                cat values.yaml

                # Update Chart version
                yq -i '.version = "1.1.1"' Chart.yaml

                # Show updated file
                cat Chart.yaml
            '''
        }
    }
}
            }
        }
        stage('build'){
            steps{
                echo 'building'
            }
        }
        stage('test'){
            steps{
                echo 'testing'
            }
        }
        stage('deploy'){
            steps{
                echo 'deploying'
            }
        }
    }

    post{
        success{
            echo 'Pipeline succeeded'
        }
        failure{
            echo 'Pipeline failed'
        }
    }
}