pipeline {
    agent {
        kubernetes {
            inheritFrom 'kaniko-agent'
        }
    }

    environment {
        IMAGE_TAG = "v1.0.0"
        DEPLOYMENT_REPO = "https://github.com/qais001-pr/School-Transport-System-Deployment.git"
        DOCKERHUB_USERNAME = "qais001"
        BACKEND_IMAGE = "school-transport-system"
        FRONTEND_IMAGE = "school-transport-web"
    }

    stages {

        // stage('Verify Tag') {
        //     steps {
        //         script {
        //             if (!env.TAG_NAME?.trim()) {
        //                 error("This pipeline must be triggered by a Git tag.")
        //             }

        //             echo "Building release: ${env.TAG_NAME}"
        //         }
        //     }
        // }

        stage('Clone Deployment Repository') {
            steps {
                container('git') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-credentials-token',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                        git --version

                        git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/qais001-pr/School-Transport-System-Deployment.git deployment

                        ls -la
                        '''
                    }
                }
            }
        }

        stage('Build & Push Backend Image') {
            steps {
                container('kaniko') {
                    sh '''
                    /kaniko/executor \
                      --context="$WORKSPACE/backend" \
                      --dockerfile="$WORKSPACE/backend/Dockerfile" \
                      --destination=${DOCKERHUB_USERNAME}/${BACKEND_IMAGE}:${IMAGE_TAG} \
                      --destination=${DOCKERHUB_USERNAME}/${BACKEND_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Build & Push Frontend Image') {
            steps {
                container('kaniko') {
                    withCredentials([
                        string(credentialsId: 'VITE_API_URL', variable: 'VITE_API_URL'),
                        string(credentialsId: 'VITE_SOCKET_URL', variable: 'VITE_SOCKET_URL'),
                        string(credentialsId: 'VITE_VAPID_PUBLIC_KEY', variable: 'VITE_VAPID_PUBLIC_KEY')
                    ]) {
                        sh '''
                        /kaniko/executor \
                          --context="$WORKSPACE/frontend" \
                          --dockerfile="$WORKSPACE/frontend/Dockerfile.k8s" \
                          --build-arg VITE_API_URL=$VITE_API_URL \
                          --build-arg VITE_SOCKET_URL=$VITE_SOCKET_URL \
                          --build-arg VITE_VAPID_PUBLIC_KEY=$VITE_VAPID_PUBLIC_KEY \
                          --destination=${DOCKERHUB_USERNAME}/${FRONTEND_IMAGE}:${IMAGE_TAG} \
                          --destination=${DOCKERHUB_USERNAME}/${FRONTEND_IMAGE}:latest
                        '''
                    }
                }
            }
        }

        stage('Update Helm Chart') {
            steps {
                container('helm') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-credentials-token',
                            usernameVariable: 'GITHUB_USER',
                            passwordVariable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                        if [ ! -f yq ]; then
                          wget -q https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O yq
                          chmod +x yq
                        fi

                        cd deployment

                        ../yq -i '.version = strenv(IMAGE_TAG)' Chart.yaml
                        ../yq -i '.client.image.tag = strenv(IMAGE_TAG)' values.yaml
                        ../yq -i '.server.image.tag = strenv(IMAGE_TAG)' values.yaml

                        git config user.name "Muhammad Qais"
                        git config user.email "qaismuhammad742@gmail.com"

                        git add .

                        git diff --cached --quiet || git commit -m "Release ${IMAGE_TAG}"

                        git push https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/qais001-pr/School-Transport-System-Deployment.git main
                        '''
                    }
                }
            }
        }

    }

    post {
        success {
            echo "Release ${IMAGE_TAG} completed successfully."
        }

        failure {
            echo "Release ${IMAGE_TAG} failed."
        }

        always {
            cleanWs()
        }
    }
}