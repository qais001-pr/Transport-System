FROM node:20-alpine

WORKDIR /app

ARG VITE_SOCKET_URL
ARG VITE_API_URL
ARG VITE_VAPID_PUBLIC_KEY

ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_VAPID_PUBLIC_KEY=${VITE_VAPID_PUBLIC_KEY}

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]